# Copy this file to .env.local and fill in your values. .env.local is gitignored.

# Default image-generation provider — Cloudflare Workers AI (FLUX.1 schnell).
# Genuinely free, no credit card required, ~230 images/day.
# 1. Sign up at https://dash.cloudflare.com
# 2. Account ID: shown on the Workers & Pages overview page
# 3. API Token: My Profile -> API Tokens -> Create Token -> give it Workers AI access
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional alternative provider (--provider gemini). Requires a billing-enabled
# Google Cloud project — the Gemini API free tier does not cover image output.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
